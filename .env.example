# Get a key from https://www.k2think.ai/ or Cerebras (https://cerebras.ai/k2think)
K2_API_KEY=

# Official hosted K2 Think v2 (OpenAI-compatible)
K2_API_BASE=https://api.k2think.ai/v1
K2_MODEL=MBZUAI-IFM/K2-Think-v2

# low | medium | high  — K2 Think reasoning effort
K2_REASONING_EFFORT=medium

# Seconds. Analysis can take longer on reasoning models.
K2_TIMEOUT=180
K2_MAX_RETRIES=3

# Public-host caps. .env is for YOUR machine only — never commit it.
K2_MAX_CALLS_PER_SESSION=8
K2_MAX_CALLS_PER_HOUR=20
K2_MAX_INPUT_CHARS=4000
